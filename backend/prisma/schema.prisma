// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companies Company[]
  documents Document[]
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  phone       String
  bankAccount String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  documents   Document[]
}

model Document {
  id          Int           @id @default(autoincrement())
  type        DocumentType
  number      String
  date        DateTime
  amount      Float
  tax         Float
  status      DocumentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      Int
  user        User          @relation(fields: [userId], references: [id])
  companyId   Int
  company     Company       @relation(fields: [companyId], references: [id])
  items       DocumentItem[]
}

model DocumentItem {
  id          Int      @id @default(autoincrement())
  name        String
  quantity    Int
  unitPrice   Float
  amount      Float
  documentId  Int
  document    Document @relation(fields: [documentId], references: [id])
}

model Template {
  id        Int      @id @default(autoincrement())
  name      String
  type      DocumentType
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
}

enum DocumentType {
  QUOTATION
  PURCHASE_ORDER
  INVOICE
  RECEIPT
  DELIVERY_NOTE
}

enum DocumentStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}
